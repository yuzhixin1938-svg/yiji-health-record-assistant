NODE_ENV=production
LOG_LEVEL=info

# Vercel / Neon Postgres
# Example: postgresql://USER:PASSWORD@HOST/dbname?sslmode=require
DATABASE_URL=

# Vercel / Upstash Redis
# Example: rediss://default:PASSWORD@HOST:6379
REDIS_URL=

# Aliyun OSS private original-file storage
ALIYUN_OSS_REGION=oss-cn-hangzhou
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_INTERNAL=true
ALIYUN_OSS_SECURE=true
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=

# Email login / webhook
RESEND_API_KEY=
RESEND_FROM_EMAIL=医记 <login@yijijiankang.cn>
RESEND_WEBHOOK_SECRET=

# Optional monitoring webhook
HEALTHCHECK_WEBHOOK_URL=
